# ==============================================================================
# SkillMatch DNA — Unified Environment Configuration Reference
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Production (PostgreSQL): postgresql://user:password@hostname:port/dbname
# Local Development:      sqlite:///./skillmatch.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillmatch_db

# --- SECURITY & JWT ---
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=your_super_secret_production_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ORIGINS ---
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- FRONTEND CLIENT VARIABLES ---
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://your-backend-api.onrender.com/api/v1
NEXTAUTH_URL=https://your-frontend.vercel.app
NEXTAUTH_SECRET=your_32_character_nextauth_secret_here

# --- AI SERVICES ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# --- LOCAL AI FALLBACK (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- STORAGE ---
# Supported: "cloudinary", "s3", "local"
STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
