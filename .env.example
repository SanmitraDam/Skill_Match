# SkillMatch DNA - Production Environment Configuration

# --- DATABASE ---
# Local Development: sqlite:///./skillmatch.db
# Production (PostgreSQL): postgresql://user:password@hostname:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillmatch_db

# --- SECURITY ---
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=your_super_secret_production_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI SERVICES ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Google Gemini model used by the Voice Room (question gen, evaluation, streaming turns)
GEMINI_MODEL=gemini-flash-latest

# --- LOCAL AI FALLBACK (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- STORAGE ---
# Supported: "local", "s3"
STORAGE_TYPE=local
S3_BUCKET_NAME=skillmatch-dna-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
