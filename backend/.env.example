# ==============================================================================
# SkillMatch DNA — Backend Environment Variables (FastAPI)
# Location: backend/.env (Local/PaaS) or Render/Railway/Fly.io Environment Settings
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Production: Use PostgreSQL (Supabase, Neon, Railway Postgres, AWS RDS)
# Syntax: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_password@ep-cool-db.us-east-1.aws.neon.tech/skillmatch_db

# Local Development Fallback:
# DATABASE_URL=sqlite:///./skillmatch.db

# --- SECURITY & JWT AUTHENTICATION ---
# Secret key used to sign JWT access tokens (Min 32 characters)
# Generate with: openssl rand -hex 32
SECRET_KEY=your_64_character_hex_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS SETTINGS ---
# Comma-separated list of allowed frontend origins. Must include your Vercel URL!
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- AI INFERENCE ENGINES ---
# Groq Cloud API Key (for Ultra-fast Llama-3.3-70B assessment generation)
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (for Voice AI Interview Room & Multimodal Evaluation)
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# --- LOCAL AI FALLBACK (Optional in Cloud) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- ASSET & RESUME STORAGE ---
# Supported: "database" (Stores files directly in CockroachDB/PostgreSQL - Recommended for Vercel), "cloudinary", "s3", or "local"
STORAGE_TYPE=database
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional AWS S3 (if STORAGE_TYPE=s3)
# S3_BUCKET_NAME=skillmatch-dna-uploads
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# --- SERVER CONFIGURATION ---
PORT=8000

