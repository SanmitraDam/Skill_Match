# ==============================================================================
# SkillMatch DNA — Frontend Environment Variables (Next.js)
# Location: frontend/dna-web/.env.local (Local) or Vercel Environment Variables
# ==============================================================================

# --- BACKEND API CONNECTIONS ---
# Public URL of your deployed FastAPI backend (Do NOT add trailing slash)
# Example (Production): https://skillmatch-api.onrender.com
# Example (Local):      http://localhost:8000
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com

# Base API v1 endpoint (Defaults to ${NEXT_PUBLIC_API_URL}/api/v1)
NEXT_PUBLIC_API_BASE_URL=https://your-backend-api.onrender.com/api/v1

# --- NEXTAUTH / AUTHENTICATION ---
# Canonical URL of your deployed frontend on Vercel (Do NOT add trailing slash)
# Example: https://skill-match.vercel.app
NEXTAUTH_URL=https://your-frontend.vercel.app

# Secret used to encrypt NextAuth sessions and JWT tokens (32+ random characters)
# Generate one using terminal: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_32_chars_random_key_here

